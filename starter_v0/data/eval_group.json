      "phase": "B",
      "suite": "group",
      "turns": [
        {"role": "user", "content": "Tóm tắt bài này: https://openai.com/research/"},
        {"role": "user", "content": "Ngoài tóm tắt, kiểm tra policy về cách trích dẫn nguồn nhé."}
      ],
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {"name": "fetch", "args": {"url": "https://openai.com/research/"}},
