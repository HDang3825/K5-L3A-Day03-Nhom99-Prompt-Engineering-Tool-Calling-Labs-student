{
  "dataset_id": "day04_v2_research_group",
  "dataset_role": "group",
  "description": "Case do NHÓM tự viết thêm để cover thêm trường hợp. Mỗi case cần: id, phase='B', query HOẶC turns, failure_type (thuộc allowed_failure_types), và expect (tool_calls[...] hoặc no_tool=true). Nên kèm metadata.what_it_tests.",
  "allowed_failure_types": ["wrong_tool", "wrong_arg_value", "wrong_boundary", "unnecessary_tool", "out_of_scope", "missing_info"],
  "cases": [
    {
      "id": "G01_dedupe_before_format",
      "phase": "B",
      "suite": "group",
      "query": "Tìm tin AI từ nhiều nguồn, loại bỏ bài trùng nhau rồi tạo bản tin ngắn.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {"name": "lookup", "args": {"query": "AI"}},
          {"name": "dedupe", "args": {}},
          {"name": "format", "args": {"template": "brief"}}
        ]
      },
      "metadata": {
        "difficulty": "hard",
        "what_it_tests": "Tìm kiếm, loại kết quả trùng URL bằng dedupe, rồi format thành brief."
      }
    },
    {
      "id": "G02_missing_article_url",
      "phase": "B",
      "suite": "group",
      "query": "Đọc và tóm tắt bài nghiên cứu này giúp mình.",
      "failure_type": "missing_info",
      "expect": {
        "tool_calls": [
          {"name": "clarify", "args": {"response_type": "text"}}
        ]
      },
      "metadata": {
        "difficulty": "easy",
        "what_it_tests": "Thiếu URL cụ thể thì hỏi lại, không tự đoán bài viết."
      }
    },
    {
      "id": "G03_top_ai_tweets_with_limit",
      "phase": "B",
      "suite": "group",
      "query": "Tìm 8 tweet phổ biến nhất về AI agents trên Twitter.",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {"name": "social_search", "args": {"query": "AI agents", "search_type": "Top", "limit": 8}}
        ]
      },
      "metadata": {
        "difficulty": "medium",
        "what_it_tests": "Chủ đề Twitter dùng social_search, top dùng search_type=Top và trích đúng limit."
      }
    },
    {
      "id": "G04_confirm_before_telegram",
      "phase": "B",
