      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {"name": "policy", "args": {"policy_area": "ai_research"}}
        ]
      },
      "metadata": {
        "difficulty": "medium",
        "what_it_tests": "Câu hỏi về quy trình nghiên cứu nội bộ dùng policy thay vì tìm kiếm web."
      }
    },
    {
      "id": "M01_clarify_then_timeline",
      "phase": "B",
      "suite": "group",
      "turns": [
        {"role": "user", "content": "Tóm tắt 6 tweet mới nhất giúp mình."},
