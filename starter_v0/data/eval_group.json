    },
    {
      "id": "M04_search_then_dedupe_digest",
      "phase": "B",
      "suite": "group",
      "turns": [
        {"role": "user", "content": "Tìm tin mới về AI agents trên web."},
        {"role": "user", "content": "Lọc các bài trùng nhau rồi trình bày thành các mục."}
      ],
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {"name": "lookup", "args": {"query": "AI agents"}},
          {"name": "dedupe", "args": {}},
          {"name": "format", "args": {"template": "sections"}}
        ]
      },
      "metadata": {
        "difficulty": "hard",
        "what_it_tests": "Giữ kết quả tìm kiếm qua lượt sau và gọi dedupe trước format sections."
      }
    },
    {
      "id": "M05_confirm_send_after_prompt",
      "phase": "B",
      "suite": "group",
      "turns": [
        {"role": "user", "content": "Đăng bản tin này lên Telegram."},
        {"role": "assistant", "content": "Bạn có xác nhận gửi bản tin ra Telegram không?"},
        {"role": "user", "content": "Có, tôi xác nhận gửi."}
      ],
      "failure_type": "wrong_boundary",
      "expect": {
        "tool_calls": [
          {"name": "send", "args": {"confirmed": true}}
        ]
      },
      "metadata": {
        "difficulty": "hard",
        "what_it_tests": "Sau khi user xác nhận rõ ràng ở lượt sau, gọi send với confirmed=true."
      }
